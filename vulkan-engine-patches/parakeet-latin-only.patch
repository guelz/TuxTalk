+int parakeet_set_blocked_tokens(struct parakeet_context * ctx, int n_tokens, const int * tokens) {
+    const int n_pieces = ctx->vocab.n_vocab;
+    for (int i = 0; i < n_tokens; i++) {
+        if (tokens[i] < 0 || tokens[i] >= n_pieces) {
+            return -1;
+        }
+    }
+    auto & blocked = ctx->state->blocked;
+    blocked.assign(n_tokens > 0 ? n_pieces : 0, 0);
+    for (int i = 0; i < n_tokens; i++) {
+        blocked[tokens[i]] = 1;
+    }
+    return n_tokens;
+}
+
+int parakeet_blocked_hits(struct parakeet_context * ctx) {
+    return ctx->state->blocked_hits;
+}
